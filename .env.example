# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Embedding endpoint (any OpenAI-compatible /v1/embeddings service).
# Used by the text route (--pipeline text / hybrid).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output dimension.
EMBEDDING_DIM=1536
# Max input tokens the embedding model accepts.
EMBEDDING_MAX_TOKENS=8191

# Chat endpoint (any OpenAI-compatible /v1/chat/completions service).
# Used for answer generation, answer grading and --rerank llm.
# LLM_MODEL must accept images. The key may be the same one as above.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: different models for grading and reranking (default: LLM_MODEL).
# JUDGE_MODEL=
# RERANK_MODEL=

# Optional: Hugging Face mirror if huggingface.co is slow.
# HF_ENDPOINT=https://hf-mirror.com
