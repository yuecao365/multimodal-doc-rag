# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Embedding endpoint (any OpenAI-compatible /v1/embeddings service).
# Used by the text route (--pipeline text / hybrid).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output dimension.
EMBEDDING_DIM=1536
# Max input tokens the embedding model accepts.
EMBEDDING_MAX_TOKENS=8191

# Chat endpoint (any OpenAI-compatible /v1/chat/completions service).
# Used for answer generation, answer grading and --rerank llm.
# LLM_MODEL must accept images. The key may be the same one as above.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Optional: different models for grading and reranking (default: LLM_MODEL).
JUDGE_MODEL=gpt-6.1-terra
# RERANK_MODEL=
# Models need a price in mmrag.models.PRICES. Paid scripts stop at this total (USD).
# BUDGET_USD=25

# Optional: where indexes and caches are stored (default: rag_storage/ in the project).
# MMRAG_WORK_ROOT=D:\rag_cache\mmrag_work

# Optional: Python of the environment that has torch and colpali-engine. Needed only
# for --local-query-encoder (queries that are not in queries.npz).
# VISUAL_PYTHON=D:\rag_cache\venv_gpu\Scripts\python.exe
# Hugging Face cache that holds the visual model, if not the default one.
# VISUAL_HF_HOME=D:\rag_cache\hf

# Optional: Hugging Face mirror if huggingface.co is slow.
# HF_ENDPOINT=https://hf-mirror.com
